local function makePage()
	local s = Instance.new("ScrollingFrame", frame)
	s.Size = UDim2.new(1, 0, 1, -75)
	s.Position = UDim2.new(0, 0, 0, 70)
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 3
	s.CanvasSize = UDim2.new(0, 0, 0, 0)
	s.Visible = false
	return s
end
local pageH, pageC = makePage(), makePage()

local function tabBtn(text, x)
	local b = Instance.new("TextButton", frame)
	b.Size = UDim2.new(0.5, -16, 0, 26)
	b.Position = UDim2.new(x, x == 0 and 12 or 4, 0, 36)
	b.Font, b.TextSize, b.Text = Enum.Font.GothamBold, 12, text
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	return b
end
local tabH, tabC = tabBtn("Нимб", 0), tabBtn("China Hat", 0.5)
local function show(p)
	pageH.Visible, pageC.Visible = p == pageH, p == pageC
	tabH.BackgroundColor3 = p == pageH and Color3.new(1, 1, 1) or Color3.fromRGB(45, 45, 45)
	tabH.TextColor3 = p == pageH and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1)
	tabC.BackgroundColor3 = p == pageC and Color3.new(1, 1, 1) or Color3.fromRGB(45, 45, 45)
	tabC.TextColor3 = p == pageC and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1)
end
tabH.MouseButton1Click:Connect(function() show(pageH) end)
tabC.MouseButton1Click:Connect(function() show(pageC) end)

local function slider(page, tbl, name, min, max, key, y)
	local lbl = Instance.new("TextLabel", page)
	lbl.Size = UDim2.new(1, -24, 0, 18)
	lbl.Position = UDim2.new(0, 12, 0, y)
	lbl.BackgroundTransparency = 1
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
	lbl.Font, lbl.TextSize = Enum.Font.Gotham, 13

	local track = Instance.new("Frame", page)
	track.Size = UDim2.new(1, -30, 0, 10)
	track.Position = UDim2.new(0, 12, 0, y + 22)
	track.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame", track)
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local function refresh()
		fill.Size = UDim2.new((tbl[key] - min) / (max - min), 0, 1, 0)
		lbl.Text = string.format("%s: %.2f", name, tbl[key])
	end
	refresh()

	local dragging = false
	local function set(x)
		local r = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		tbl[key] = min + (max - min) * r
		refresh()
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, frame.Draggable = true, false
			set(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			set(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, frame.Draggable = false, true
		end
	end)
end

local function toggle(page, tbl, text, y)
	local b = Instance.new("TextButton", page)
	b.Size = UDim2.new(1, -30, 0, 26)
	b.Position = UDim2.new(0, 12, 0, y)
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.TextColor3 = Color3.fromRGB(20, 20, 20)
	b.Font, b.TextSize = Enum.Font.GothamBold, 13
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	local function r() b.Text = text .. (tbl.On and ": ВКЛ" or ": ВЫКЛ") end
	r()
	b.MouseButton1Click:Connect(function() tbl.On = not tbl.On r() end)
end

-- таблица цветов
local function palette(page, tbl, y)
	local lbl = Instance.new("TextLabel", page)
	lbl.Size = UDim2.new(1, -24, 0, 18)
	lbl.Position = UDim2.new(0, 12, 0, y)
	lbl.BackgroundTransparency = 1
	lbl.Text = "Цвет"
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
	lbl.Font, lbl.TextSize = Enum.Font.Gotham, 13

	local cols, size, gap = 6, 30, 6
	local swatches = {}
	local function mark()
		for _, s in ipairs(swatches) do
			s.stroke.Transparency = (s.color == tbl.Color) and 0 or 1
		end
	end
	for i, hex in ipairs(PALETTE) do
		local col = Color3.fromHex(hex)
		local b = Instance.new("TextButton", page)
		b.Size = UDim2.new(0, size, 0, size)
		b.Position = UDim2.new(0, 12 + ((i - 1) % cols) * (size + gap), 0, y + 24 + math.floor((i - 1) / cols) * (size + gap))
		b.BackgroundColor3 = col
		b.Text = ""
		b.AutoButtonColor = false
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
		local st = Instance.new("UIStroke", b)
		st.Color, st.Thickness, st.Transparency = Color3.fromRGB(255, 80, 80), 2, 1
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		swatches[i] = {color = col, stroke = st}
		b.MouseButton1Click:Connect(function()
			tbl.Color = col
			mark()
		end)
	end
	mark()
	return y + 24 + math.ceil(#PALETTE / cols) * (size + gap) + 6
end

-- Нимб
toggle(pageH, H, "Нимб", 4)
local hs = {
	{"Высота", 0.5, 4, "Height"}, {"Ширина", 0.4, 3, "Width"},
	{"Свечение", 0, 10, "Glow"}, {"Толщина", 0.05, 0.5, "Thick"},
}
for i, s in ipairs(hs) do slider(pageH, H, s[1], s[2], s[3], s[4], 38 + (i - 1) * 44) end
local endH = palette(pageH, H, 38 + #hs * 44)
pageH.CanvasSize = UDim2.new(0, 0, 0, endH)

-- China Hat
toggle(pageC, C, "China Hat", 4)
local cs = {
	{"Ширина", 0.5, 4, "Width"}, {"Высота", 0.2, 3, "Height"},
	{"Позиция Y", -1, 3, "Y"}, {"Позиция X", -2, 2, "X"}, {"Позиция Z", -2, 2, "Z"},
}
for i, s in ipairs(cs) do slider(pageC, C, s[1], s[2], s[3], s[4], 38 + (i - 1) * 44) end
local endC = palette(pageC, C, 38 + #cs * 44)
pageC.CanvasSize = UDim2.new(0, 0, 0, endC)

show(pageH)

UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then
		frame.Visible = not frame.Visible
	end
end)
