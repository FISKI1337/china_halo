local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

local H = {On = true, Height = 1.4, Width = 1.1, Glow = 3, Thick = 0.15, Color = Color3.fromRGB(255, 240, 170)}
local C = {On = true, Width = 1.6, Height = 1.0, X = 0, Y = 0.6, Z = 0, Color = Color3.fromRGB(255, 255, 255)}

local PALETTE = {
	"#FFFFFF", "#BFBFBF", "#7F7F7F", "#000000", "#FF3B3B", "#FF8A3B",
	"#FFD93B", "#FFF0AA", "#A6FF3B", "#3BFF6B", "#3BFFD9", "#3BB8FF",
	"#3B6BFF", "#7A3BFF", "#C73BFF", "#FF3BC7", "#FF7A9E", "#8B5A2B",
	"#00A86B", "#B0E0E6", "#FFC0CB", "#E6E6FA", "#FFD700", "#DC143C",
}

-- ===== Нимб (плоское кольцо) =====
local SEG = 48
local folder = Instance.new("Folder", workspace)
folder.Name = "AngelHalo"
local parts = {}
for i = 1, SEG do
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Parent = folder
	parts[i] = p
end
local core = Instance.new("Part")
core.Anchored, core.CanCollide, core.CanQuery, core.CanTouch = true, false, false, false
core.Transparency, core.Size = 1, Vector3.new(0.1, 0.1, 0.1)
core.Parent = folder
local light = Instance.new("PointLight", core)

-- ===== China Hat (Drawing API) =====
local N = 32
local hasDrawing = typeof(Drawing) == "table" or typeof(Drawing) == "userdata"
local tris, base, side = {}, {}, {}
if hasDrawing then
	for i = 1, N do
		local t = Drawing.new("Triangle")
		t.Filled, t.Transparency, t.Visible = true, 0.6, false
		tris[i] = t
		local l = Drawing.new("Line")
		l.Thickness, l.Transparency, l.Visible = 2, 1, false
		base[i] = l
	end
	for i = 1, 2 do
		local l = Drawing.new("Line")
		l.Thickness, l.Transparency, l.Visible = 2, 1, false
		side[i] = l
	end
end

local function hideHat()
	for i = 1, N do tris[i].Visible = false; base[i].Visible = false end
	side[1].Visible = false; side[2].Visible = false
end

RS.RenderStepped:Connect(function()
	local char = lp.Character
	local head = char and char:FindFirstChild("Head")

	-- нимб
	for _, p in ipairs(parts) do
		p.Transparency = (head and H.On) and 0 or 1
		p.Color = H.Color
	end
	light.Enabled = head ~= nil and H.On
	light.Color, light.Brightness, light.Range = H.Color, H.Glow, 6 + H.Glow * 3
	if head then
		local c = head.Position + Vector3.new(0, H.Height, 0)
		local len = 2 * H.Width * math.sin(math.pi / SEG) * 1.15
		core.CFrame = CFrame.new(c)
		for i, p in ipairs(parts) do
			local a = (i - 1) / SEG * math.pi * 2
			local pos = c + Vector3.new(math.cos(a), 0, math.sin(a)) * H.Width
			local tan = Vector3.new(-math.sin(a), 0, math.cos(a))
			p.Size = Vector3.new(H.Thick, 0.05, len)
			p.CFrame = CFrame.lookAt(pos, pos + tan)
		end
	end

	-- china hat
	if not hasDrawing then return end
	hideHat()
	if not (head and C.On) then return end

	local center = head.Position + Vector3.new(C.X, C.Y, C.Z)
	local camPos = cam.CFrame.Position
	local a3 = cam:WorldToViewportPoint(center + Vector3.new(0, C.Height, 0))
	if a3.Z <= 0 then return end
	local apex = Vector2.new(a3.X, a3.Y)

	local pts = {}
	for i = 1, N do
		local a = (i - 1) / N * math.pi * 2
		local v = cam:WorldToViewportPoint(center + Vector3.new(math.cos(a), 0, math.sin(a)) * C.Width)
		if v.Z <= 0 then return end
		pts[i] = Vector2.new(v.X, v.Y)
	end

	-- какие грани смотрят на камеру
	local below = camPos.Y < center.Y
	local facing = {}
	for i = 1, N do
		local m = (i - 0.5) / N * math.pi * 2
		local dir = Vector3.new(math.cos(m), 0, math.sin(m))
		local normal = Vector3.new(dir.X * C.Height, C.Width, dir.Z * C.Height)
		local mid = center + dir * C.Width
		facing[i] = normal:Dot(camPos - mid) > 0
	end

	local outline = Color3.new(1, 1, 1)
	for i = 1, N do
		-- сверху рисуем передние грани, снизу - внутренние (дальние)
		local drawFace = (facing[i] ~= below)
		local j = i % N + 1
		if drawFace then
			local t = tris[i]
			t.PointA, t.PointB, t.PointC = apex, pts[i], pts[j]
			t.Color, t.Visible = C.Color, true
		end
		-- снизу основание видно целиком
		if drawFace or below then
			local l = base[i]
			l.From, l.To, l.Color, l.Visible = pts[i], pts[j], outline, true
		end
	end

	-- боковой контур (граница между видимыми и невидимыми гранями)
	local count = 0
	for i = 1, N do
		local prev = i == 1 and N or i - 1
		if facing[i] ~= facing[prev] and count < 2 then
			count += 1
			side[count].From, side[count].To = apex, pts[i]
			side[count].Color, side[count].Visible = outline, true
		end
	end
end)

